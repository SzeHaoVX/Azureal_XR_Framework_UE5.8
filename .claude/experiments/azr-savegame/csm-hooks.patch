+// --- SAVE / RESUME ---
+
+void UChapterSubsystem::Initialize(FSubsystemCollectionBase& Collection)
+{
+    Super::Initialize(Collection);
+
+    // The framework owns the save file; the curriculum just contributes a payload to it. Binding
+    // this way keeps the dependency one-directional -- AzurealXR has no idea CSM exists.
+    if (UGameInstance* GameInstance = GetGameInstance())
+    {
+        if (UAzr_SaveSubsystem* SaveSubsystem = GameInstance->GetSubsystem<UAzr_SaveSubsystem>())
+        {
+            SaveSubsystem->OnCaptureSave.AddDynamic(this, &UChapterSubsystem::HandleCaptureSave);
+            SaveSubsystem->OnRestoreSave.AddDynamic(this, &UChapterSubsystem::HandleRestoreSave);
+        }
+    }
+}
+
+void UChapterSubsystem::Deinitialize()
+{
+    if (UGameInstance* GameInstance = GetGameInstance())
+    {
+        if (UAzr_SaveSubsystem* SaveSubsystem = GameInstance->GetSubsystem<UAzr_SaveSubsystem>())
+        {
+            SaveSubsystem->OnCaptureSave.RemoveDynamic(this, &UChapterSubsystem::HandleCaptureSave);
+            SaveSubsystem->OnRestoreSave.RemoveDynamic(this, &UChapterSubsystem::HandleRestoreSave);
+        }
+    }
+    Super::Deinitialize();
+}
+
+void UChapterSubsystem::HandleCaptureSave(UAzr_SaveGame* SaveGame)
+{
+    if (!SaveGame)
+    {
+        return;
+    }
+
+    FCsm_SaveState State;
+    State.CurrentIndex = CurrentIndex;
+    State.CompletedChapters = CompletedChapterIndexes.Array();
+    State.ChapterStepProgress = ChapterStepProgress;
+    State.bHasPassedStartScreen = bHasPassedStartScreen;
+
+    // Fold in where the learner actually is inside the current step. The page is a widget, so the
+    // framework's actor sweep cannot reach it -- it has to hand its position over itself.
+    if (UTrainingStepPage* Page = ActiveStepPage.Get())
+    {
+        Page->CapturePageState(State);
+        UE_LOG(LogTemp, Log, TEXT("[AzrSave/CSM] capture: page registered, step %d of %d, sub-progress %d entries"),
+            State.CurrentViewingIndex, State.PageProgressMemory.Num(),
+            State.PageProgressMemory.IsValidIndex(State.CurrentViewingIndex) ? State.PageProgressMemory[State.CurrentViewingIndex] : -1);
+    }
+    else
+    {
+        UE_LOG(LogTemp, Warning, TEXT("[AzrSave/CSM] capture: NO step page registered -- sub-step position will NOT be saved."));
+    }
+
+    FAzr_PayloadRecord Payload;
+    FMemoryWriter Writer(Payload.Data, true);
+    FObjectAndNameAsStringProxyArchive Ar(Writer, false);
+    Ar.ArNoDelta = true;
+    FCsm_SaveState::StaticStruct()->SerializeItem(FStructuredArchiveFromArchive(Ar).GetSlot(), &State, nullptr);
+
+    SaveGame->Payloads.Add(TEXT("CSM"), MoveTemp(Payload));
+}
+
+void UChapterSubsystem::HandleRestoreSave(UAzr_SaveGame* SaveGame)
+{
+    if (!SaveGame)
+    {
+        return;
+    }
+
+    const FAzr_PayloadRecord* Payload = SaveGame->Payloads.Find(TEXT("CSM"));
+    if (!Payload || Payload->Data.Num() == 0)
+    {
+        return;
+    }
+
+    FCsm_SaveState State;
+    FMemoryReader Reader(Payload->Data, true);
+    FObjectAndNameAsStringProxyArchive Ar(Reader, true);
+    Ar.ArNoDelta = true;
+    FCsm_SaveState::StaticStruct()->SerializeItem(FStructuredArchiveFromArchive(Ar).GetSlot(), &State, nullptr);
+
+    CurrentIndex = State.CurrentIndex;
+    CompletedChapterIndexes = TSet<int32>(State.CompletedChapters);
+    ChapterStepProgress = State.ChapterStepProgress;
+    bHasPassedStartScreen = State.bHasPassedStartScreen;
+
+    // The page position is parked rather than applied. It cannot be applied yet from either direction:
+    // the page may not exist, and even if it does it has no steps until the learner starts the chapter,
+    // at which point SetTotalSessionSteps would wipe whatever had been written anyway. The page claims
+    // this the moment it knows its own step count.
+    if (State.bHasPageState)
+    {
+        PendingPageState = State;
+        bHasPendingPageState = true;
+        UE_LOG(LogTemp, Log, TEXT("[AzrSave/CSM] restore: page position parked (chapter %d, step %d) -- waiting for the step page to claim it."),
+            State.CurrentIndex, State.CurrentViewingIndex);
+    }
+    else
+    {
+        UE_LOG(LogTemp, Warning, TEXT("[AzrSave/CSM] restore: save carries NO page position -- the chapter will open at step 1."));
+    }
+
+    // The menu and step page read their contents from this subsystem, so tell them it has changed.
+    OnChapterDataUpdated.Broadcast();
+}
+
+bool UChapterSubsystem::HasPendingResume() const
+{
+    if (bHasPendingPageState)
+    {
+        return true;
+    }
+
+    // The widget asks this during its own construction, which happens before the snapshot lands.
+    // The save subsystem raised its flag before the level travel, so it is the only side that knows.
+    if (const UGameInstance* GameInstance = GetGameInstance())
+    {
+        if (const UAzr_SaveSubsystem* Save = GameInstance->GetSubsystem<UAzr_SaveSubsystem>())
+        {
+            return Save->IsResumePending();
+        }
+    }
+    return false;
+}
+
+void UChapterSubsystem::RegisterStepPage(UTrainingStepPage* Page)
+{
+    // Only remember the page. Applying here would be far too early: registration happens in
+    // NativeConstruct, before the learner has pressed Start, so the page has no steps yet -- its arrays
+    // are empty and TotalStepsCount is 0. Writing a restored position into that would clamp every index
+    // to zero and destroy the very state being restored.
+    //
+    // The page pulls its position itself once it knows how many steps it has. See
+    // UTrainingStepPage::SetTotalSessionSteps.
+    ActiveStepPage = Page;
+}
+
+bool UChapterSubsystem::PeekPendingPageState(FCsm_SaveState& OutState) const
+{
+    if (!bHasPendingPageState)
+    {
+        return false;
+    }
+
+    OutState = PendingPageState;
+    return true;
+}
+
+void UChapterSubsystem::ClearPendingPageState()
+{
+    if (!bHasPendingPageState)
+    {
+        return;
+    }
+
+    bHasPendingPageState = false;
+    PendingPageState = FCsm_SaveState();
+    UE_LOG(LogTemp, Log, TEXT("[AzrSave/CSM] resume finished -- parked position released."));
+}
+
+int32 UChapterSubsystem::GetResumeStepIndex() const
+{
+    return ChapterStepProgress.FindRef(CurrentIndex);
+}
 
