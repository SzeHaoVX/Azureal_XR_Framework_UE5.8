+// --- SAVE / RESUME ---
+
+void UTrainingStepPage::CapturePageState(FCsm_SaveState& OutState) const
+{
+    UE_LOG(LogTemp, Log, TEXT("[AzrSave/CSM] capture detail: viewing=%d maxUnlocked=%d furthest=%d subProgress=%d"),
+        CurrentViewingIndex, MaxUnlockedIndex, FurthestVisitedIndex,
+        PageProgressMemory.IsValidIndex(CurrentViewingIndex) ? PageProgressMemory[CurrentViewingIndex] : -1);
+
+    OutState.bHasPageState = true;
+    OutState.PageProgressMemory = PageProgressMemory;
+    OutState.StepTriggerHistory = StepTriggerHistory;
+    OutState.CurrentViewingIndex = CurrentViewingIndex;
+    OutState.MaxUnlockedIndex = MaxUnlockedIndex;
+    OutState.FurthestVisitedIndex = FurthestVisitedIndex;
+    OutState.bSessionFinished = bSessionFinished;
+}
+
+void UTrainingStepPage::ApplyPageState(const FCsm_SaveState& State)
+{
+    if (!State.bHasPageState)
+    {
+        return;
+    }
+
+    ApplyPageStateData(State);
+    RefreshResumedDisplay();
+}
+
+void UTrainingStepPage::ApplyPageStateData(const FCsm_SaveState& State)
+{
+    if (!State.bHasPageState)
+    {
+        return;
+    }
+
+    // Refuse to write a position into a page that has no steps. Clamping against a zero-length list
+    // would silently collapse every restored index to 0 and then report the chapter as complete.
+    if (TotalStepsCount <= 0)
+    {
+        return;
+    }
+
+    // The steps themselves are rebuilt from the data asset, so only the position is restored here.
+    // Anything longer than the freshly built list is discarded rather than trusted: the curriculum may
+    // legitimately have fewer steps than the save expected.
+    PageProgressMemory = State.PageProgressMemory;
+    StepTriggerHistory = State.StepTriggerHistory;
+    PageProgressMemory.SetNum(TotalStepsCount, EAllowShrinking::Yes);
+    StepTriggerHistory.SetNum(TotalStepsCount, EAllowShrinking::Yes);
+
+    CurrentViewingIndex  = FMath::Clamp(State.CurrentViewingIndex,  0, FMath::Max(TotalStepsCount, 0));
+    MaxUnlockedIndex     = FMath::Clamp(State.MaxUnlockedIndex,     0, FMath::Max(TotalStepsCount, 0));
+    FurthestVisitedIndex = FMath::Clamp(State.FurthestVisitedIndex, 0, FMath::Max(TotalStepsCount, 0));
+    bSessionFinished     = State.bSessionFinished;
+}
+
+void UTrainingStepPage::RefreshResumedDisplay()
+{
+    if (TotalStepsCount <= 0)
+    {
+        return;
+    }
+
+    // Show the restored step. TryFireNextStepEvent is gated by StepTriggerHistory, which was restored
+    // above, so the sequencer re-arms the step being resumed without replaying the earlier ones.
+    OnPageChanged(CurrentViewingIndex);
+    EvaluateCurrentPageType();
+    RefreshList();
+    UpdateNextButtonState();
+    OnUpdateNavigationButtons();
+    ScrollToActiveSubStep();
+
+    if (CurrentViewingIndex < TotalStepsCount)
+    {
+        TryFireNextStepEvent(CurrentViewingIndex);
+    }
+    else if (CurrentViewingIndex == TotalStepsCount)
+    {
+        OnChapterCompleted();
+    }
+}
+
+void UTrainingStepPage::SaveProgressNow()
+{
+    UGameInstance* GI = GetGameInstance();
+    if (!GI)
+    {
+        return;
+    }
+
+    UAzr_SaveSubsystem* Save = GI->GetSubsystem<UAzr_SaveSubsystem>();
+    if (!Save || Save->IsRestoring())
+    {
+        // Saving in the middle of applying a restore would capture a half-rebuilt world.
+        return;
+    }
+
+    // Reaching a sub-step boundary means the learner has moved past the point they resumed from, so the
+    // parked position has done its job. Released here rather than on first use, so that every earlier
+    // re-initialisation of the page still lands on the saved step.
+    if (UChapterSubsystem* Subsystem = GI->GetSubsystem<UChapterSubsystem>())
+    {
+        Subsystem->ClearPendingPageState();
+    }
+
+    // Elapsed time is kept as a duration on the subsystem, not as a start stamp on this widget: world
+    // time restarts on level load, and the widget itself is destroyed and rebuilt.
+    //
+    // Only the time accrued since this page began is added to what was already banked. Assigning the
+    // page's own elapsed time would throw away everything before the resume, so a learner who saved an
+    // hour in and came back would show a couple of minutes.
+    if (GetWorld() && !bSessionFinished)
+    {
+        const float SincePageStarted = GetWorld()->GetTimeSeconds() - SessionStartTime;
+        Save->SetAccumulatedSeconds(BankedSecondsAtPageStart + FMath::Max(SincePageStarted, 0.0f));
+    }
+
+    // Something for a Continue button to show. 1-based, matching everything else Blueprint-facing.
+    if (UChapterSubsystem* Subsystem = GI->GetSubsystem<UChapterSubsystem>())
+    {
+        int32 ChapterNumber = 0;
+        FAzr_MultiLangText ChapterTitle;
+        Subsystem->GetCurrentChapterInfo(ChapterNumber, ChapterTitle);
+        Save->SetProgressLabel(FString::Printf(TEXT("Chapter %d - Step %d of %d"),
+            ChapterNumber, FMath::Min(CurrentViewingIndex + 1, TotalStepsCount), TotalStepsCount));
+    }
+
+    Save->SaveProgress();
+}
