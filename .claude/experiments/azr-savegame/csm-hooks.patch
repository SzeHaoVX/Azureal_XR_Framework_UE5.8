+    // which then goes on to run Build Step UI -- so anything written now is redrawn a moment later.
+    // The queued position is applied on the next tick, once every caller has finished.
+    if (UGameInstance* GI = GetGameInstance())
+    {
+        if (UChapterSubsystem* Subsystem = GI->GetSubsystem<UChapterSubsystem>())
+        {
+            FCsm_SaveState Resume;
+            if (Subsystem->PeekPendingPageState(Resume))
+            {
+                // The DATA goes back immediately, in the same frame the Init above wiped it. That
+                // matters more than it looks: StepTriggerHistory was just cleared to all-false, and
+                // anything running later in this frame -- Build Step UI, for one -- reads that as "no
+                // step has fired yet", fires one, and pushes the Game Manager a step past the learner.
+                // Deferring this by even a tick leaves that gap wide open.
+                ApplyPageStateData(Resume);
+
+                // Only the REDRAW waits for the next tick, because Build Step UI runs after this
+                // function and would paint over anything drawn now.
+                bResumeQueued = true;
+                UE_LOG(LogTemp, Log, TEXT("[AzrSave/CSM] step page: %d steps built, position restored to step %d (redraw next tick)."),
