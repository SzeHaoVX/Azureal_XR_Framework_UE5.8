+void UTrainingStepPage::ApplyQueuedResume()
+{
+    bResumeQueued = false;
+
+    UGameInstance* GI = GetGameInstance();
+    UChapterSubsystem* Subsystem = GI ? GI->GetSubsystem<UChapterSubsystem>() : nullptr;
+    if (!Subsystem)
+    {
+        return;
+    }
+
+    FCsm_SaveState Resume;
+    if (!Subsystem->PeekPendingPageState(Resume) || TotalStepsCount <= 0)
+    {
+        return;
+    }
+
+    // Carry forward the time already banked, so the clock continues rather than restarts.
+    if (UAzr_SaveSubsystem* Save = GI->GetSubsystem<UAzr_SaveSubsystem>())
+    {
+        BankedSecondsAtPageStart = Save->GetAccumulatedSeconds();
+    }
+
+    UE_LOG(LogTemp, Log, TEXT("[AzrSave/CSM] redrawing resumed page: viewing=%d maxUnlocked=%d furthest=%d (of %d steps)"),
+        Resume.CurrentViewingIndex, Resume.MaxUnlockedIndex, Resume.FurthestVisitedIndex, TotalStepsCount);
+
+    // Data was already restored in SetTotalSessionSteps; this is only the redraw. Re-applied here as
+    // well so a re-initialisation that happened without a resume still lands on the right values.
+    //
+    // The parked position is deliberately NOT released. Any later re-initialisation -- the menu's Start
+    // path, for one -- wipes the page back to step one, and would strand the learner there if the
+    // position had already been thrown away. It is released once they actually advance.
+    ApplyPageStateData(Resume);
+    RefreshResumedDisplay();
